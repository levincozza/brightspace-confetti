{
  "manifest_version": 3,
  "name": "Brightspace Confetti Spaghetti",
  "version": "1.2",
  "description": "Mimics Canvas' revolutionary submission confetti on brightspace. Spaghetti.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["confetti.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["success.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
